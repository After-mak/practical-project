# 이 파일을 values-secret.yaml로 복사한 뒤 실제 값을 채워서 사용하세요.
# values-secret.yaml은 .gitignore에 등록되어 있어 커밋되지 않습니다.
#
#   cp values-secret.yaml.example values-secret.yaml
#   # (편집 후)
#   helm upgrade --install finops . -f values.yaml -f values-secret.yaml
#
# 이미 클러스터에 Secret을 만들어 두었다면 이 파일 대신 values.yaml의
# telegram.existingSecret에 그 Secret 이름을 지정해도 됩니다. 이 경우 해당 Secret은
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID 두 개의 key를 가지고 있어야 합니다.

telegram:
  botToken: "replace-me"
  chatId: "replace-me"
