# ==========================================
# ⚙️ FinOps Telegram Alert Gateway 환경 변수 예시
# ==========================================

# 1. 텔레그램 봇 설정
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 2. GitHub API & GitOps 설정
GITOPS_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_REPO_OWNER="After-mak"
GITHUB_REPO_NAME="mak-argocd-deploy"
TARGET_BRANCH="main"

# 3. FinOps(KRR) 정책 엔진 서비스 주소 (infra_approve/infra_reject 콜백 처리 시 최종 cpu/memory 조회용)
FINOPS_URL="http://finops.finops.svc.cluster.local:8000"